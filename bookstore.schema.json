{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Bookstore",
  "type": "object",
  "properties": {
    "properties": {
      "color":{
        "enum": ["red", "orange", "yellow", "green", "blue", "purple", "pink", "brown", "gray", "black", "white"]
      },
      "allOf": [
        {"type": "string", "maxLength": 100}
      ],
      "$defs":{
        "bookInfo": {
          "properties": {
            "isbn": {"type": "number"},
            "title": {"type": "string"},
            "author": {"type": "string"},
            "pages": {"type": "number", "minimum": 1, "maximum": 2000},
            "published": {"type": "string"},
            "price": {"type": "number", "exclusinveMaximum": 100, "exclusinveMinimum": 0.01}
          },
          "required": [
            "isbn", "title"
          ]
        }
      },
      "bookstore": {
        "type": "object",
        "properties": {
          "books": {
            "type": "object",
            "properties": {
              "fiction": {
                "type": "object",
                "properties": {
                  "book": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "$ref": "#/$defs/bookInfo"
                    }
                  }
                }
              },
              "non-fiction": {
                "type": "object",
                "properties": {
                  "book": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "isbn": {
                          "type": "number"
                        },
                        "title": {
                          "type": "string"
                        },
                        "author": {
                          "type": "string"
                        },
                        "pages": {
                          "type": "number"
                        },
                        "published": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "isbn",
                        "title"
                      ]
                    }
                  }
                }
              }
            }
          },
          "notebooks": {
            "type": "object",
            "properties": {
              "lined": {
                "type": "object",
                "properties": {
                  "notebook": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^(NL-[0-9][0-9][0-9])"
                        },
                        "pages": {
                          "type": "number"
                        },
                        "format": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number"
                        },
                        "color": {
                          "type": "color"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              },
              "dotted": {
                "type": "object",
                "properties": {
                  "notebook": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "pages": {
                          "type": "number"
                        },
                        "format": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              },
              "squared": {
                "type": "object",
                "properties": {
                  "notebook": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "pages": {
                          "type": "number"
                        },
                        "format": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              },
              "blank": {
                "type": "object",
                "properties": {
                  "notebook": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "pages": {
                          "type": "number"
                        },
                        "format": {
                          "type": "string"
                        },
                        "price": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              }
            }
          },
          "postcards": {
            "type": "object",
            "properties": {
              "postcard": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "design": {
                      "type": "string"
                    },
                    "price": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}