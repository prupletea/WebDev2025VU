<schema targetNamespace="http://www.w3.org/2001/XMLSchema" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">
    
  <xs:simpleType name="Price">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0.00"/>
      <xs:fractionDigits value="2"></xs:fractionDigits>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PreviousPrices">
    <xs:list itemType="Price"/>
  </xs:simpleType>

  <xs:complexType name="PriceWithCurrency">
    <xs:simpleContent>
      <xs:extension base="xs:Price">
        <xs:attribute name="Currency" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ItemPrice">
    <xs:simpleContent>
      <xs:restriction base="xs:PriceWithCurrency">
        <xs:maxInclusive value="999"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="Book" mixed="true">
    <xs:sequence>
      <xs:element name="isbn" type="long" minOccurs="1" maxOccurs="1">
        <xs:unique name="UniqueISBN">
          <xs:selector xpath="BookInfo"/>
          <xs:field xpath="@isbn"/>
        </xs:unique>
      </xs:element>
      <xs:element name="author" type="string" minOccurs="1" maxOccurs="10"/>
      <xs:element name="title" type="string" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BookInfo" mixed="true">
    <xs:complexContent>
      <xs:extension base="xs:Book">
        <xs:sequence>
          <xs:element name="pages" type="int" maxOccurs="1"></xs:element>
          <xs:element name="published" type="date" minOccurs="1"/>
          <xs:element name="price" type="xs:ItemPrice" maxOccurs="1"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--Missing - complext type, complext content with restriction-->

  <xs:complexType name="BookType">
    <xs:choice>
      <xs:element name="fiction"/>
      <xs:element name="non-fiction"/>
    </xs:choice>
  </xs:complexType>

  <element name="bookstore">
    <complexType>
      <sequence>
        <element name="books">
          <complexType>
            <sequence>
              <element name="fiction">
                <complexType>
                  <sequence>
                    <element name="book" maxOccurs="unbounded" minOccurs="0">
                      <complexType>
                        <sequence>
                          <element type="string" name="title"/>
                          <element type="string" name="author"/>
                          <element type="int" name="pages"/>
                          <element type="date" name="published"/>
                          <element type="ItemPrice" name="price"/>
                        </sequence>
                        <attribute type="long" name="isbn" use="required"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="non-fiction">
                <complexType>
                  <sequence>
                    <element name="book">
                      <complexType>
                        <sequence>
                          <element type="string" name="title"/>
                          <element type="string" name="author"/>
                          <element type="int" name="pages"/>
                          <element type="date" name="published"/>
                          <element type="ItemPrice" name="price"/>
                        </sequence>
                        <attribute type="long" name="isbn" use="required"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
        <element name="notebooks">
          <complexType>
            <sequence>
              <element name="lined">
                <complexType>
                  <sequence>
                    <element name="notebook">
                      <complexType>
                        <sequence>
                          <element type="int" name="pages"/>
                          <element type="string" name="format"/>
                          <element type="ItemPrice" name="price"/>
                        </sequence>
                        <attribute type="string" name="id" use="required"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="dotted">
                <complexType>
                  <sequence>
                    <element name="notebook">
                      <complexType>
                        <sequence>
                          <element type="int" name="pages"/>
                          <element type="string" name="format"/>
                          <element type="ItemPrice" name="price"/>
                        </sequence>
                        <attribute type="string" name="id" use="required"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="squared">
                <complexType>
                    <sequence>
                        <element name="notebook">
                            <complexType>
                                <sequence>
                                  <element type="int" name="pages"/>
                                  <element type="string" name="format"/>
                                  <element type="ItemPrice" name="price"/>
                                </sequence>
                                <attribute type="string" name="id" use="required"/>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
              </element>
              <element name="blank">
                <complexType>
                    <sequence>
                        <element name="notebook">
                            <complexType>
                                <sequence>
                                  <element type="int" name="pages"/>
                                  <element type="string" name="format"/>
                                  <element type="ItemPrice" name="price"/>
                                </sequence>
                                <attribute type="string" name="id" use="required"/>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
        <element name="postcards">
          <complexType>
            <sequence>
              <element name="postcard">
                <complexType>
                  <sequence>
                    <element type="string" name="design"/>
                    <element type="ItemPrice" name="price"/>
                  </sequence>
                  <attribute type="string" name="id" use="required"/>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
      </sequence>
    </complexType>
  </element>
</schema>