<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="https://www.w3.org/2001/XMLSchema" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="bookstore">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="books">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fiction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="book" maxOccurs="unbounded" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element type="xs:string" name="title"/>
                          <xs:element type="xs:string" name="author"/>
                          <xs:element type="xs:int" name="pages"/>
                          <xs:element type="xs:date" name="published"/>
                          <xs:element type="xs:double" name="price"/>
                        </xs:sequence>
                        <xs:attribute type="xs:long" name="isbn"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="non-fiction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="book">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element type="xs:string" name="title"/>
                          <xs:element type="xs:string" name="author"/>
                          <xs:element type="xs:int" name="pages"/>
                          <xs:element type="xs:date" name="published"/>
                          <xs:element type="xs:double" name="price"/>
                        </xs:sequence>
                        <xs:attribute type="xs:long" name="isbn"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="notebooks">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="lined">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="notebook">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element type="xs:int" name="pages"/>
                          <xs:element type="xs:string" name="format"/>
                          <xs:element type="xs:double" name="price"/>
                        </xs:sequence>
                        <xs:attribute type="xs:string" name="id"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="dotted">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="notebook">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element type="xs:int" name="pages"/>
                          <xs:element type="xs:string" name="format"/>
                          <xs:element type="xs:double" name="price"/>
                        </xs:sequence>
                        <xs:attribute type="xs:string" name="id"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="squared">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="notebook">
                            <xs:complexType>
                                <xs:sequence>
                                  <xs:element type="xs:int" name="pages"/>
                                  <xs:element type="xs:string" name="format"/>
                                  <xs:element type="xs:double" name="price"/>
                                </xs:sequence>
                                <xs:attribute type="xs:string" name="id"/>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="blank">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="notebook">
                            <xs:complexType>
                                <xs:sequence>
                                  <xs:element type="xs:int" name="pages"/>
                                  <xs:element type="xs:string" name="format"/>
                                  <xs:element type="xs:double" name="price"/>
                                </xs:sequence>
                                <xs:attribute type="xs:string" name="id"/>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="postcards">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="postcard">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element type="xs:string" name="design"/>
                    <xs:element type="xs:double" name="price"/>
                  </xs:sequence>
                  <xs:attribute type="xs:string" name="id"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>