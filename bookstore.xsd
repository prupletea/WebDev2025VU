<schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema">
  <element name="bookstore">
    <complexType>
      <sequence>
        <element name="books">
          <complexType>
            <sequence>
              <element name="fiction">
                <complexType>
                  <sequence>
                    <element name="book" maxOccurs="unbounded" minOccurs="0">
                      <complexType>
                        <sequence>
                          <element type="string" name="title"/>
                          <element type="string" name="author"/>
                          <element type="int" name="pages"/>
                          <element type="date" name="published"/>
                          <element type="float" name="price"/>
                        </sequence>
                        <attribute type="long" name="isbn"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="non-fiction">
                <complexType>
                  <sequence>
                    <element name="book">
                      <complexType>
                        <sequence>
                          <element type="string" name="title"/>
                          <element type="string" name="author"/>
                          <element type="int" name="pages"/>
                          <element type="date" name="published"/>
                          <element type="float" name="price"/>
                        </sequence>
                        <attribute type="long" name="isbn"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
        <element name="notebooks">
          <complexType>
            <sequence>
              <element name="lined">
                <complexType>
                  <sequence>
                    <element name="notebook">
                      <complexType>
                        <sequence>
                          <element type="int" name="pages"/>
                          <element type="string" name="format"/>
                          <element type="float" name="price"/>
                        </sequence>
                        <attribute type="string" name="id"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="dotted">
                <complexType>
                  <sequence>
                    <element name="notebook">
                      <complexType>
                        <sequence>
                          <element type="int" name="pages"/>
                          <element type="string" name="format"/>
                          <element type="float" name="price"/>
                        </sequence>
                        <attribute type="string" name="id"/>
                      </complexType>
                    </element>
                  </sequence>
                </complexType>
              </element>
              <element name="squared">
                <complexType>
                    <sequence>
                        <element name="notebook">
                            <complexType>
                                <sequence>
                                  <element type="int" name="pages"/>
                                  <element type="string" name="format"/>
                                  <element type="float" name="price"/>
                                </sequence>
                                <attribute type="string" name="id"/>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
              </element>
              <element name="blank">
                <complexType>
                    <sequence>
                        <element name="notebook">
                            <complexType>
                                <sequence>
                                  <element type="int" name="pages"/>
                                  <element type="string" name="format"/>
                                  <element type="float" name="price"/>
                                </sequence>
                                <attribute type="string" name="id"/>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
        <element name="postcards">
          <complexType>
            <sequence>
              <element name="postcard">
                <complexType>
                  <sequence>
                    <element type="string" name="design"/>
                    <element type="float" name="price"/>
                  </sequence>
                  <attribute type="string" name="id"/>
                </complexType>
              </element>
            </sequence>
          </complexType>
        </element>
      </sequence>
    </complexType>
  </element>
</schema>